{
  "name": "dj-library-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready REST API for managing a DJ track library",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "cross-env DATABASE_URL=file:./test.db prisma generate && cross-env DATABASE_URL=file:./test.db prisma db push --skip-generate && cross-env DATABASE_URL=file:./test.db vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger-ui": "^2.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "music-metadata": "^10.9.0",
    "zod": "^3.23.8",
    "@prisma/client": "^5.19.1",
    "alpinejs": "^3.14.9",
    "prisma": "^5.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "cross-env": "^7.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
